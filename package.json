{
  "name": "@alaturkavakitler/core",
  "version": "0.1.1",
  "description": "Shared core for Alaturka Vakitler: hijri calendar, prayer times, alaturka clock, qibla.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./data/*": "./data/*"
  },
  "files": [
    "src",
    "data",
    "fixtures"
  ],
  "scripts": {
    "extract": "node scripts/extract-data.js",
    "mirror": "node scripts/mirror-data.js",
    "fixtures": "TZ=Europe/Istanbul node scripts/make-fixtures.js",
    "test": "TZ=Europe/Istanbul node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saatleriayarlamaenstitusu/alaturka-core.git"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/saatleriayarlamaenstitusu/alaturka-core/issues"
  },
  "homepage": "https://alaturkavakitler.com",
  "keywords": [
    "hijri",
    "prayer-times",
    "namaz",
    "vakit",
    "alaturka",
    "qibla",
    "diyanet",
    "turkey"
  ],
  "engines": {
    "node": ">=18"
  }
}
